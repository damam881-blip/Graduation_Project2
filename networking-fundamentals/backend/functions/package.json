{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "fixtures:seed": "node scripts/seed-emulator.cjs",
    "fixtures:verify": "node scripts/verify-fixtures.cjs",
    "fixtures:test": "node --test tests/fixtures.test.cjs",
    "catalog:test": "node --test tests/catalog.test.cjs",
    "content:test": "node --test ../tests/content.n3.test.mjs",
    "content:import:validate": "node scripts/import-content.cjs validate",
    "content:import:stage": "node scripts/import-content.cjs stage",
    "content:import:preview": "node scripts/import-content.cjs preview",
    "content:import:publish": "node scripts/import-content.cjs publish",
    "content:import:rollback": "node scripts/import-content.cjs rollback",
    "content:assets:serve": "node scripts/serve-assets.cjs",
    "ai:export:test": "node --test ../tests/ai-export.n3.test.mjs",
    "ai:export:validate": "node scripts/export-ai.cjs validate",
    "ai:export:run": "node scripts/export-ai.cjs export",
    "ai:export:preview": "node scripts/export-ai.cjs preview"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "typescript": "^6.0.0"
  },
  "private": true
}
